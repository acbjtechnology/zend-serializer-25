{
    "name": "acbjtechnology/zend-serializer-25",
    "description": "provides an adapter based interface to simply generate storable representation of PHP types by different facilities, and recover",
    "license": "BSD-3-Clause",
    "keywords": [
        "zf2",
        "serializer"
    ],
    "homepage": "https://github.com/acbjtechnology/zend-serializer-25",
    "autoload": {
        "psr-4": {
            "Zend\\Serializer\\": "src/"
        }
    },
    "require": {
        "php": ">=7.3",
        "acbjtechnology/zend-stdlib-25": "@dev",
        "acbjtechnology/zend-json-25": "@dev",
        "acbjtechnology/zend-math-25": "@dev"
    },
    "require-dev": {
        "zendframework/zend-servicemanager": "~2.5"
    },
    "suggest": {
        "zendframework/zend-servicemanager": "To support plugin manager support"
    },
    "minimum-stability": "dev",
    "prefer-stable": false,
    "extra": {
        "branch-alias": {
            "dev-master": "main",
            "dev-develop": "52-1-1-dev"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ZendTest\\Serializer\\": "test/"
        }
    },
    "repositories" : [
        {
            "type":"package",
            "package": {
                "name": "acbjtechnology/zend-stdlib-25",
                "version":"dev-main",
                "source": {
                    "url": "https://github.com/acbjtechnology/zend-stdlib-25.git",
                    "type": "git",
                    "reference":"main"
                },
                "autoload": {
                    "psr-4": {
                        "Zend\\Stdlib\\": "src/"
                    }
                }
            }
        },
        {
            "type":"package",
            "package": {
                "name": "acbjtechnology/zend-json-25",
                "version":"dev-main",
                "source": {
                    "url": "https://github.com/acbjtechnology/zend-json-25.git",
                    "type": "git",
                    "reference":"main"
                },
                "autoload": {
                    "psr-4": {
                        "Zend\\Stdlib\\": "src/"
                    }
                }
            }
        },
        {
            "type":"package",
            "package": {
                "name": "acbjtechnology/zend-math-25",
                "version":"dev-main",
                "source": {
                    "url": "https://github.com/acbjtechnology/zend-math-25.git",
                    "type": "git",
                    "reference":"main"
                },
                "autoload": {
                    "psr-4": {
                        "Zend\\Stdlib\\": "src/"
                    }
                }
            }
        }
    ]

}